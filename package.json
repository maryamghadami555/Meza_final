{
  "name": "meza-accessory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply meza-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meza-db --remote",
    "db:seed:local": "wrangler d1 execute meza-db --local --file seed.sql",
    "create-admin": "node scripts/create-admin.mjs",
    "start": "tsx server/index.ts",
    "railway:admin": "tsx server/migrate.ts --admin",
    "admin:local": "wrangler d1 execute meza-db --local --file admin-account.sql",
    "admin:remote": "wrangler d1 execute meza-db --remote --file admin-account.sql"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.1.0",
    "hono": "^4.6.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^11.5.0",
    "tsx": "^4.19.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.0"
  },
  "engines": {
    "node": ">=20"
  }
}